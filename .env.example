# Snowflake의 계정 식별자입니다. 예: myorg-myaccount
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=seohyunho

# 비밀번호 인증을 사용할 때 입력하세요.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE

# 키 페어 인증을 사용한다면 authenticator를 SNOWFLAKE_JWT로 바꾸고 아래를 설정하세요.
# SNOWFLAKE_PRIVATE_KEY_PATH=C:\secure\rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# 쿼리 실행에 사용할 웨어하우스와 역할입니다. 사용자 기본값이 있으면 비워둘 수 있습니다.
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

SNOWFLAKE_DATABASE=MEMBER
SNOWFLAKE_SCHEMA=PUBLIC
PORT=43177
